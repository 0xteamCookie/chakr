{
  "name": "@agentshield/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "cross-env DATABASE_URL=file:../.data/agentshield.db prisma db push --skip-generate && tsx watch src/server.ts",
    "start": "cross-env DATABASE_URL=file:../.data/agentshield.db prisma db push --skip-generate && tsx src/server.ts",
    "db:push": "cross-env DATABASE_URL=file:../.data/agentshield.db prisma db push",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/eval/cli.ts",
    "postinstall": "prisma generate",
    "eval:llm": "tsx src/eval/cli-llm.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "viem": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "cross-env": "^10.1.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}