# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- LLM (Gemini, for the real-agent runs and the AgentDojo harness) ---
# Free key: https://aistudio.google.com  ("Get API key")
GOOGLE_GENERATIVE_AI_API_KEY=
PROVIDER=google
MODEL=gemini-2.5-flash

# --- Core / dashboard (defaults shown; leave as is for local dev) ---
PORT=4317
NEXT_PUBLIC_API_URL=http://localhost:4317

# --- Optional: Open Policy Agent (e.g. via docker compose) ---
OPA_URL=

# --- Optional: testnet anchoring. Left empty = local anchoring (the default) ---
ANCHOR_RPC_URL=
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT=

# --- Optional: real Gmail inbox for /live ("Load from Gmail"). Read-only over IMAP. ---
# Use a separate demo account: the agent sends each email to the model. Needs 2-step verification and an app
# password (Google account > Security > App passwords). Payments and outgoing mail stay simulated.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# GMAIL_MAILBOX=INBOX
# GMAIL_LIMIT=6
# GMAIL_SINCE_HOURS=72
